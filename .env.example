# Magic Potion - Production Environment Variables
# Copy to .env and fill in values
# CRITICAL: Verify all addresses on etherscan before deploying

# ──── Alchemix V3 (Mix USDC / ETH mainnet) ────
# Source: https://control.alchemix.fi/addresses (Mix USDC / ETH)
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ALUSD_ADDRESS=0xBC6DA0FE9aD5f3b0d58160288917AA56653660E9
ALCHEMIST_ADDRESS=0xeB83112d925268BeDe86654C13D423a987587e3E
MYT_VAULT_ADDRESS=0x9B44efCa3e2a707B63Dc00CE79d646E5E5D24bA5
# Options are the 6 whitelisted USDC strategies. The Alchemist deposit()
# takes yield tokens directly (not underlying USDC), so we need to either:
# a) Use the token adapter to auto-wrap USDC -> yield token
# b) Deposit USDC via the AlchemistTokenVault or Liquidity Adapter
# c) Pick a specific strategy vault and deposit into it first
YIELD_TOKEN_ADDRESS=TBD_VERIFY_STRATEGIES

# ──── Chainlink VRF V2.5 (mainnet) ────
VRF_COORDINATOR=0x50e47677a03e54D66c258BA18367D7122B5d21bE
VRF_SUBSCRIPTION_ID=0
# Key hash options (verify at https://docs.chain.link/vrf/v2-5/subscription/supported-networks):
# 30 gwei lane:  0x8af398995b04c28e9951adb9721ef74c74f93e6a478f39e7e0777be13527e7ef
# 500 gwei lane: 0x1770bdc7eec7771e710f98e649ea9ac281a918c0c973599b0686ba1c1f100fcd
VRF_KEY_HASH=0x8af398995b04c28e9951adb9721ef74c74f93e6a478f39e7e0777be13527e7ef

# ──── Treasury ────
# Deploy a Gnosis Safe multisig first, then put the address here
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ──── Optional: Keeper Parameters ────
# Defaults are baked into the contract. Override here if needed.
# KEEPER_BASE_REWARD=1000000000000000000    # 1 LUCK
# KEEPER_RATE_PER_STEP=100000000000000000    # 0.1 LUCK
# KEEPER_STEP_DURATION=300                    # 5 minutes (in seconds)

# ──── Deployer (DO NOT COMMIT) ────
# PRIVATE_KEY=0x...
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
